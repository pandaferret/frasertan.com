---
import BaseLayout from "./BaseLayout.astro";
import DietaryBadge from "../components/DietaryBadge.astro";
import CookMode from "../components/CookMode.astro";
import { SUBCATEGORIES } from "../subcategories";

interface Props {
  title: string;
  description?: string;
  yield?: string;
  prep?: string;
  cook?: string;
  rest?: string;
  categories: string[];
  subcategories?: string[];
  tags?: string[];
  dietary?: string[];
  source?: { name?: string; url?: string };
  cover?: string;
  quote?: { text: string; author: string };
  // schema.org Recipe data for search engines.
  schema?: Record<string, unknown>;
}

const {
  title,
  description,
  yield: recipeYield,
  prep,
  cook,
  rest,
  categories,
  subcategories,
  tags,
  dietary,
  source,
  cover,
  quote,
  schema,
} = Astro.props;

// Friendly names for common recipe sites, used when a source has a URL but
// no name. Anything else falls back to the site's domain.
const siteNames: Record<string, string> = {
  "smittenkitchen.com": "Smitten Kitchen",
  "cooksillustrated.com": "Cook's Illustrated",
  "cooking.nytimes.com": "NYT Cooking",
  "americastestkitchen.com": "America's Test Kitchen",
  "cookscountry.com": "Cook's Country",
  "allrecipes.com": "Allrecipes",
  "eatingwell.com": "EatingWell",
  "bonappetit.com": "Bon Appétit",
  "foodnetwork.com": "Food Network",
  "washingtonpost.com": "The Washington Post",
  "thekitchn.com": "The Kitchn",
  "kingarthurbaking.com": "King Arthur Baking",
  "food52.com": "Food52",
  "seriouseats.com": "Serious Eats",
  "youtube.com": "YouTube",
};
const sourceHost = source?.url
  ? new URL(source.url).hostname.replace(/^www\./, "")
  : undefined;
const sourceLabel =
  source?.name || (sourceHost && (siteNames[sourceHost] ?? sourceHost));

// Descriptions can include Markdown-style links, e.g.
// "see [Railway Potatoes](/recipes/railway-potatoes/)". Split them into text
// and link parts for the page, and strip the markup for the meta description.
const linkPattern = /\[([^\]]+)\]\(([^)\s]+)\)/g;
const descriptionParts = description
  ? description
      .split(/(\[[^\]]+\]\([^)\s]+\))/)
      .filter(Boolean)
      .map((part) => {
        const match = /^\[([^\]]+)\]\(([^)\s]+)\)$/.exec(part);
        return match ? { text: match[1], href: match[2] } : { text: part };
      })
  : [];
const plainDescription = description?.replace(linkPattern, "$1");

// "Serves 4" or "Chill 2 hr": bold the first word, like Prep and Cook.
const splitLabel = (text?: string) => {
  if (!text) return undefined;
  const match = /^(\S+)\s+(.*)$/.exec(text);
  return match
    ? { label: match[1], value: match[2] }
    : { label: text, value: "" };
};
const restParts = splitLabel(rest);
const yieldParts = splitLabel(recipeYield);

// The page shows only ingredient tags plus Eric-friendly and Owen fav. The
// other tags only decide which tag pages list the recipe, so they stay in the
// frontmatter but aren't shown here.
const pageOnlyTags = [
  "Weeknight Meals",
  "Make Ahead",
  "Seasonal Treats",
  "Christmas",
  "Thanksgiving",
  "New Year's Eve",
  "Spring",
  "Summer",
  "Fall",
  "Winter",
  "High Protein",
  "Vegetarian",
];
const shownTags = tags?.filter((tag) => !pageOnlyTags.includes(tag)) ?? [];
// Tags that are also tabs on the Weeknight Meals page link there, but only
// when the recipe is a weeknight meal, since the tab lists only those.
const weeknightTabs = [
  "Eric-friendly",
  "Owen fav",
  "Beef",
  "Chicken",
  "Pork",
  "Fish",
  "Beans",
];
const slugify = (s: string) => s.toLowerCase().replace(/ /g, "-");
const tagHref = (tag: string) =>
  weeknightTabs.includes(tag) && tags?.includes("Weeknight Meals")
    ? `/tags/weeknight-meals/#sub-${slugify(tag)}`
    : undefined;

const category = categories[0];
const categoryHref = `/categories/${category.toLowerCase().replace(/ /g, "-")}/`;
// Only a subcategory that shows as a chip on this category's page gets a
// breadcrumb, so a salad that's also a side doesn't link to a missing chip.
const subcategory = subcategories?.find((sub) =>
  SUBCATEGORIES[category]?.includes(sub),
);
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Recipes", href: "/recipes/" },
  { label: category, href: categoryHref },
  ...(subcategory
    ? [
        {
          label: subcategory,
          href: `${categoryHref}#sub-${subcategory.toLowerCase().replace(/ /g, "-")}`,
        },
      ]
    : []),
  { label: title },
];
---

<BaseLayout
  title={title}
  description={plainDescription}
  image={cover}
  breadcrumbs={breadcrumbs}
>
  {
    cover && (
      <div class="recipe-cover" slot="banner">
        <img src={cover} alt="" />
      </div>
    )
  }
  <article data-pagefind-body>
    <div class="recipe-header">
      <h1>{title}</h1>
      {
        description && (
          <p class="recipe-description">
            {descriptionParts.map((part) =>
              part.href ? <a href={part.href}>{part.text}</a> : part.text,
            )}
          </p>
        )
      }
      {
        quote && (
          <figure class="recipe-quote">
            <blockquote>
              {quote.text.split(/\n\s*\n/).map((para) => (
                <p>{para.trim()}</p>
              ))}
            </blockquote>
            <figcaption>{quote.author}</figcaption>
          </figure>
        )
      }
      <div class="recipe-meta">
        {
          (prep || cook || restParts) && (
            <span class="recipe-times">
              {prep && (
                <span>
                  <strong>Prep</strong> {prep}
                </span>
              )}
              {cook && (
                <span>
                  <strong>Cook</strong> {cook}
                </span>
              )}
              {restParts && (
                <span>
                  <strong>{restParts.label}</strong> {restParts.value}
                </span>
              )}
            </span>
          )
        }
        {
          yieldParts && (
            <span>
              <strong>{yieldParts.label}</strong> {yieldParts.value}
            </span>
          )
        }
        {
          dietary && dietary.length > 0 && (
            <span class="badges">
              {dietary.map((code) => (
                <>
                  {" "}
                  <DietaryBadge code={code} searchable />
                  <meta
                    data-pagefind-filter="dietary[content]"
                    content={code}
                  />
                </>
              ))}
            </span>
          )
        }
      </div>
      {
        shownTags.length > 0 && (
          <ul class="recipe-tags" aria-label="Tags">
            {shownTags.map((tag) => {
              const href = tagHref(tag);
              return (
                <li>
                  {href ? (
                    <a class="tag" href={href}>
                      {tag}
                    </a>
                  ) : (
                    <span class="tag">{tag}</span>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
      {
        categories.map((cat) => (
          <meta data-pagefind-filter="category[content]" content={cat} />
        ))
      }
      {
        tags?.map((tag) => (
          <meta data-pagefind-filter="tag[content]" content={tag} />
        ))
      }
      <CookMode />
    </div>
    <hr />
    <slot />
    {
      source && (source.name || source.url) && (
        <p class="recipe-source">
          Source:{" "}
          {source.url ? (
            <a href={source.url} target="_blank" rel="noopener">
              {sourceLabel}
            </a>
          ) : (
            source.name
          )}
        </p>
      )
    }
  </article>
  {
    schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
      />
    )
  }
  <slot name="after" />
</BaseLayout>
