---
import { ViewTransitions } from "astro:transitions";
import Navigation from "../components/Navigation.astro";
import Breadcrumbs, { type Crumb } from "../components/Breadcrumbs.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: Crumb[];
  hideHeader?: boolean;
}

const { title, description, breadcrumbs, hideHeader } = Astro.props;
const pageTitle =
  title === "Home"
    ? "Fraser Elisabeth Tan, PhD"
    : `${title} - Fraser Elisabeth Tan, PhD`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ViewTransitions />
  </head>
  <body>
    {!hideHeader && <Navigation />}
    <slot name="banner" />
    <main class="container">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        &copy; {new Date().getFullYear()} Fraser Elisabeth Tan
      </div>
    </footer>
  </body>
</html>
