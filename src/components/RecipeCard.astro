---
import DietaryBadge from "./DietaryBadge.astro";

interface Props {
  title: string;
  slug: string;
  dietary?: string[];
  cover?: string;
}

const { title, slug, dietary, cover } = Astro.props;
const href = `/recipes/${slug}/`;
// Cards use a smaller copy of the cover saved alongside it in cards/.
const thumb = cover?.replace(/\/([^/]+)$/, "/cards/$1");
---

<div class="recipe-card">
  <a class="recipe-card-cover" href={href} tabindex="-1" aria-hidden="true">
    {
      thumb ? (
        <img src={thumb} alt="" loading="lazy" decoding="async" />
      ) : (
        <svg
          class="recipe-card-placeholder"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7 3v7a2 2 0 0 0 2 2v9" />
          <path d="M11 3v7a2 2 0 0 1-2 2" />
          <path d="M9 3v6" />
          <path d="M17 21V3c-2 1.5-3 4-3 7v3h3" />
        </svg>
      )
    }
  </a>
  <div class="recipe-card-body">
    <h3><a href={href}>{title}</a></h3>
    {
      dietary && dietary.length > 0 && (
        <div class="badges">
          {dietary.map((code) => (
            <DietaryBadge code={code} />
          ))}
        </div>
      )
    }
  </div>
</div>
