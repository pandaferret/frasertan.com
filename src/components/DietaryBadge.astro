---
interface Props {
  code: string;
  // Index the full name ("Gluten-Free") for site search, on recipe pages.
  searchable?: boolean;
}

const { code, searchable = false } = Astro.props;
const base = code.replace(/\*$/, "").toUpperCase();
const labels: Record<string, string> = {
  GF: "Gluten-Free",
  DF: "Dairy-Free",
  EF: "Egg-Free",
  V: "Vegan",
  VEG: "Vegetarian",
};
// A trailing * means the recipe gets there with a swap or two.
const label = labels[base]
  ? (code.endsWith("*") ? "Can Be " : "") + labels[base]
  : code;
const cssClass = `badge badge-${base.toLowerCase()}`;
---

<span
  class={cssClass}
  title={label}
  data-pagefind-index-attrs={searchable ? "title" : undefined}>{code}</span
>
