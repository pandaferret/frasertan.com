---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipeBrowser from "../../components/RecipeBrowser.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export function getStaticPaths() {
  const tagNames = [
    "Weeknight Meals",
    "Make Ahead",
    "Seasonal Treats",
    "High Protein",
  ];
  return tagNames.map((tag) => ({
    params: { tag: tag.toLowerCase().replace(/ /g, "-") },
    props: { tagName: tag },
  }));
}

// Each tag page's buttons, drawn from these extra tags on its recipes
// (they mirror tags and diets in Fraser's Notion recipe database).
const subtags: Record<string, string[]> = {
  "Weeknight Meals": [
    "Eric-friendly",
    "Owen fav",
    "Beef",
    "Chicken",
    "Pork",
    "Fish",
    "Vegetarian",
    "Beans",
  ],
  // Holidays from Fraser's "Food for All Reasons and All Seasons" page, then
  // the Season column.
  "Seasonal Treats": [
    "Christmas",
    "Thanksgiving",
    "New Year's Eve",
    "Spring",
    "Summer",
    "Fall",
    "Winter",
  ],
  "High Protein": ["Poultry", "Beef", "Pork", "Fish", "Vegetarian"],
};

// High Protein buttons go by each recipe's main protein, from its
// subcategories or protein tags (Chicken counts as Poultry). Eggs, lamb and
// a few others fit none of these and go under "Other".
const proteinOf = (r: CollectionEntry<"recipes">) =>
  [...(r.data.subcategories ?? []), ...(r.data.tags ?? [])].map((g) =>
    g === "Chicken" ? "Poultry" : g,
  );

const { tagName } = Astro.props;
const recipes = await getCollection("recipes");
const tagged = recipes
  .filter((r) => r.data.tags?.includes(tagName))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title={tagName}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Recipes", href: "/recipes/" },
    { label: tagName },
  ]}
>
  <h1>{tagName}</h1>
  <RecipeBrowser
    recipes={tagged}
    groups={subtags[tagName] ?? []}
    groupsOf={tagName === "High Protein" ? proteinOf : (r) => r.data.tags ?? []}
    showOther={tagName === "High Protein"}
    filter={{ name: "tag", value: tagName }}
    searchLabel={`Search ${tagName.toLowerCase()}`}
  />
</BaseLayout>
