---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipeBrowser from "../../components/RecipeBrowser.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  const tagNames = ["Weeknight Meals", "Make Ahead", "Seasonal Treats"];
  return tagNames.map((tag) => ({
    params: { tag: tag.toLowerCase().replace(/ /g, "-") },
    props: { tagName: tag },
  }));
}

// Tag pages have no subcategories, so their tabs are recipe categories.
const categories = [
  "Starters",
  "Salads",
  "Soups and Stews",
  "Main Dishes",
  "Sauces and Dips",
  "Side Dishes",
  "Breads and Baked Goods",
  "Desserts",
  "Breakfast",
  "Drinks",
];

const { tagName } = Astro.props;
const recipes = await getCollection("recipes");
const tagged = recipes
  .filter((r) => r.data.tags?.includes(tagName))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title={tagName}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Recipes", href: "/recipes/" },
    { label: tagName },
  ]}
>
  <h1>{tagName}</h1>
  <RecipeBrowser
    recipes={tagged}
    groups={categories}
    groupsOf={(r) => r.data.categories}
    filter={{ name: "tag", value: tagName }}
    searchLabel={`Search ${tagName.toLowerCase()}`}
  />
</BaseLayout>
