---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipeBrowser from "../../components/RecipeBrowser.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  const tagNames = ["Weeknight Meals", "Make Ahead", "Seasonal Treats"];
  return tagNames.map((tag) => ({
    params: { tag: tag.toLowerCase().replace(/ /g, "-") },
    props: { tagName: tag },
  }));
}

// Each tag page's buttons, drawn from these extra tags on its recipes
// (they mirror tags in Fraser's Notion recipe database).
const subtags: Record<string, string[]> = {
  "Weeknight Meals": ["Eric-friendly", "Owen fav"],
};

const { tagName } = Astro.props;
const recipes = await getCollection("recipes");
const tagged = recipes
  .filter((r) => r.data.tags?.includes(tagName))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title={tagName}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Recipes", href: "/recipes/" },
    { label: tagName },
  ]}
>
  <h1>{tagName}</h1>
  <RecipeBrowser
    recipes={tagged}
    groups={subtags[tagName] ?? []}
    groupsOf={(r) => r.data.tags ?? []}
    showOther={false}
    filter={{ name: "tag", value: tagName }}
    searchLabel={`Search ${tagName.toLowerCase()}`}
  />
</BaseLayout>
