---
import BaseLayout from "../../layouts/BaseLayout.astro";

const categories = [
  "Starters",
  "Salads",
  "Soups and Stews",
  "Main Dishes",
  "Sauces and Dips",
  "Side Dishes",
  "Breads and Baked Goods",
  "Desserts",
  "Breakfast",
  "Drinks",
];

const categoryLinks = categories.map((cat) => ({
  name: cat,
  slug: cat.toLowerCase().replace(/ /g, "-"),
}));
---

<BaseLayout
  title="Categories"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Recipes", href: "/recipes/" },
    { label: "Categories" },
  ]}
>
  <h1>Recipe Categories</h1>
  <ul class="category-list">
    {
      categoryLinks.map(({ name, slug }) => (
        <li>
          <a href={`/categories/${slug}/`}>{name}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
