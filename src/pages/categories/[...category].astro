---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipeBrowser from "../../components/RecipeBrowser.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  const categories = [
    "Starters",
    "Salads",
    "Soups and Stews",
    "Main Dishes",
    "Sauces and Dips",
    "Side Dishes",
    "Breads and Baked Goods",
    "Desserts",
    "Breakfast",
    "Drinks",
  ];
  return categories.map((cat) => ({
    params: { category: cat.toLowerCase().replace(/ /g, "-") },
    props: { categoryName: cat },
  }));
}

const { categoryName } = Astro.props;
const recipes = await getCollection("recipes");
const inCategory = recipes
  .filter((r) => r.data.categories.includes(categoryName))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

// Subcategories aren't tied to a category in the frontmatter, so a recipe in
// two categories would otherwise carry its chips onto both pages. List the
// chips each category page shows; categories not listed get no chips.
const SUBCATEGORIES: Record<string, string[]> = {
  "Main Dishes": [
    "Beef",
    "Fish",
    "Pastas and Grains",
    "Pizzas",
    "Pork",
    "Poultry",
    "Slow Cooker Goodness",
    "Sundries",
  ],
  Desserts: [
    "Cakes and Cupcakes",
    "Cookies",
    "Crumbles, Cobblers, Buckles and Bars",
    "Frostings and Sauces",
    "Pies and Tarts",
    "Sweets and Sundries",
  ],
  "Soups and Stews": ["Slow Cooker Goodness", "Soups"],
};
const subcategories = SUBCATEGORIES[categoryName] ?? [];
---

<BaseLayout
  title={categoryName}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Recipes", href: "/recipes/" },
    { label: "Categories", href: "/categories/" },
    { label: categoryName },
  ]}
>
  <h1>{categoryName}</h1>
  <RecipeBrowser
    recipes={inCategory}
    groups={subcategories}
    groupsOf={(r) => r.data.subcategories ?? []}
    filter={{ name: "category", value: categoryName }}
    searchLabel={`Search ${categoryName.toLowerCase()}`}
  />
</BaseLayout>
