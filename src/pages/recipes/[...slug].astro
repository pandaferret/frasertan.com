---
import { getCollection, render } from "astro:content";
import RecipeLayout from "../../layouts/RecipeLayout.astro";
import { recipeSchema } from "../../recipe-schema";
import MoreLikeThis from "../../components/MoreLikeThis.astro";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
---

<RecipeLayout {...recipe.data} schema={recipeSchema(recipe, Astro.site!)}>
  <div class="recipe-body">
    <Content />
  </div>
  <MoreLikeThis recipe={recipe} slot="after" />
</RecipeLayout>
