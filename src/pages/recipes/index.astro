---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Search from "../../components/Search.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import { getCollection } from "astro:content";

const recent = (await getCollection("recipes"))
  .filter((r) => r.data.added)
  .sort((a, b) => b.data.added!.getTime() - a.data.added!.getTime())
  .slice(0, 6);

const categories = [
  "Starters",
  "Salads",
  "Soups and Stews",
  "Main Dishes",
  "Sauces and Dips",
  "Side Dishes",
  "Breads and Baked Goods",
  "Desserts",
  "Breakfast",
  "Drinks",
];

const tags = [
  "Weeknight Meals",
  "Make Ahead",
  "Seasonal Treats",
  "High Protein",
  "Special Diets",
];
---

<BaseLayout
  title="Recipes"
  description="Browse all recipes"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Recipes" }]}
>
  <h1>Recipes</h1>

  <Search />

  <h2>By Course</h2>
  <ul class="category-list category-list--fives">
    {
      categories.map((cat) => {
        const slug = cat.toLowerCase().replace(/ /g, "-");
        return (
          <li>
            <a href={`/categories/${slug}/`}>{cat}</a>
          </li>
        );
      })
    }
  </ul>

  <h2>By Specialties</h2>
  <ul class="category-list category-list--fives">
    {
      tags.map((tag) => {
        const slug = tag.toLowerCase().replace(/ /g, "-");
        return (
          <li>
            <a href={`/tags/${slug}/`}>{tag}</a>
          </li>
        );
      })
    }
  </ul>

  {
    recent.length > 0 && (
      <>
        <h2>Recently Added</h2>
        <div class="recent-row">
          {recent.map((r) => (
            <RecipeCard
              title={r.data.title}
              slug={r.id}
              dietary={r.data.dietary}
              cover={r.data.cover}
            />
          ))}
        </div>
      </>
    )
  }
</BaseLayout>
