---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Search from "../../components/Search.astro";
import { getCollection } from "astro:content";
import { dietsOf } from "../../diets";

const recipes = await getCollection("recipes");
const categories = [
  "Starters",
  "Salads",
  "Soups and Stews",
  "Main Dishes",
  "Sauces and Dips",
  "Side Dishes",
  "Breads and Baked Goods",
  "Desserts",
  "Breakfast",
  "Drinks",
];

const tags = [
  "Weeknight Meals",
  "Make Ahead",
  "Seasonal Treats",
  "Special Diets",
];
// Special Diets gathers recipes by their diet badges rather than a tag.
const inTag = (tag: string, r: (typeof recipes)[number]) =>
  tag === "Special Diets"
    ? dietsOf(r).length > 0
    : !!r.data.tags?.includes(tag);
---

<BaseLayout
  title="Recipes"
  description="Browse all recipes"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Recipes" }]}
>
  <h1>Recipes</h1>

  <Search />

  <h2>Categories</h2>
  <ul class="category-list">
    {
      categories.map((cat) => {
        const slug = cat.toLowerCase().replace(/ /g, "-");
        const count = recipes.filter((r) =>
          r.data.categories.includes(cat),
        ).length;
        return (
          <li>
            <a href={`/categories/${slug}/`}>
              {cat}
              <span class="count">{count} recipes</span>
            </a>
          </li>
        );
      })
    }
  </ul>

  <h2>Tags</h2>
  <ul class="category-list">
    {
      tags.map((tag) => {
        const slug = tag.toLowerCase().replace(/ /g, "-");
        const count = recipes.filter((r) => inTag(tag, r)).length;
        return (
          <li>
            <a href={`/tags/${slug}/`}>
              {tag}
              <span class="count">{count} recipes</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
